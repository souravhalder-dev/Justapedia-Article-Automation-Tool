# ==============================================================================
# Justapedia Article Research, Update & Creation Automation Studio
# Configuration & Secrets Environment File
# ==============================================================================

# Application Port and Debugging
PORT=8000
DEBUG=false

# Justapedia Wiki MediaWiki API Endpoint
# Default: https://justapedia.org/api.php
JUSTAPEDIA_API_URL=https://justapedia.org/api.php

# Justapedia Account Credentials (Bot Password recommended)
# To create a Bot Password on Justapedia:
# 1. Log in to your Justapedia account
# 2. Go to Special:BotPasswords (https://justapedia.org/wiki/Special:BotPasswords)
# 3. Create a bot grant with "Edit existing pages" and "Create, edit, and move pages"
# 4. Fill in JUSTAPEDIA_BOT_USERNAME (e.g. YourUsername@BotName) and JUSTAPEDIA_BOT_PASSWORD below.
JUSTAPEDIA_BOT_USERNAME=
JUSTAPEDIA_BOT_PASSWORD=

# Safe Test Mode (Recommended for Initial Testing)
# When set to true, all article saves are safely redirected to the Sandbox page
# rather than altering live articles. You can also toggle this inside the dashboard UI.
SAFE_TEST_MODE=true
SANDBOX_PAGE_TITLE=Justapedia:Sandbox

# Google Gemini API Key (Recommended for AI Fact Verification & Draft Generation)
# Get a key from: https://aistudio.google.com/
# If left empty, the application uses its built-in rule-based Wikipedia & Wikidata synthesizer.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration (SQLite file path)
DATABASE_URL=sqlite+aiosqlite:///./backend/justapedia_editorial.db

# Rate Limiting & Safety Parameters
REQUEST_DELAY_SECONDS=0.5
MAX_BATCH_SIZE=50
